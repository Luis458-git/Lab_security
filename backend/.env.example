# ==============================================================================
# SECUREVAULT: Plantilla de Variables de Entorno (backend/.env.example)
# ADVERTENCIA: NUNCA coloques secretos reales en este archivo ni lo versiones con credenciales vivas.
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# Puerto del servidor backend Express
PORT=3000

# Cadena de conexión a PostgreSQL (Neon Serverless con TLS requerido)
# Formato: postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/securevault?sslmode=require

# Secreto unificado para firma de sesiones, JWT y cookies (Mínimo 32 caracteres, recomendado 64 bytes hex)
# Generar en terminal con:
# openssl rand -hex 64
SESSION_SECRET=YOUR_SECURE_SESSION_SECRET_KEY_MINIMUM_64_BYTES_HEX_REPLACE_ME

# Clave simétrica para cifrado AES-256-GCM (DEBE tener exactamente 32 bytes codificados en Base64)
# Para generar una clave criptográficamente segura, ejecuta en tu terminal:
# openssl rand -base64 32
# o en Node.js: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTES_KEY_HERE_REPLACE_ME==

# Origen permitido por la política CORS (URL pública de Render o dominio de producción)
# En producción mono-servicio: https://securevault.onrender.com (o tu URL de Render)
# En desarrollo local: http://localhost:5173
CORS_ORIGIN=https://securevault-app.onrender.com

# Opcionales para configuración separada (toman SESSION_SECRET por defecto si se omiten)
# JWT_SECRET=YOUR_SECURE_JWT_SECRET
# COOKIE_SECRET=YOUR_SECURE_COOKIE_SECRET

# Nivel de detalle del Logger Pino ('trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal')
LOG_LEVEL=info
